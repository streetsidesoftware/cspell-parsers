{
  "name": "@cspell/parser-strings-comments",
  "version": "1.0.0",
  "description": "A combined strings-and-comments parser plugin for cspell covering C, C++, C#, Go, Java, JavaScript, JSX, TypeScript, TSX, PHP, Python, Ruby, and Rust.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/streetsidesoftware/cspell-parsers.git",
    "directory": "packages/parser-strings-comments"
  },
  "funding": "https://github.com/streetsidesoftware/cspell?sponsor=1",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "c",
    "cpp",
    "csharp",
    "cspell",
    "go",
    "java",
    "javascript",
    "javascriptreact",
    "parser",
    "php",
    "plugin",
    "spell",
    "spellchecker",
    "typescript",
    "typescriptreact"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./recommended": {
      "types": "./dist/recommended.d.ts",
      "default": "./dist/recommended.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "shx rm -rf dist coverage",
    "test": "pnpm run test:vitest && pnpm run test:cspell",
    "test:cspell": "cspell . --no-progress",
    "test:vitest": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cspell/parser-c-cpp-strings-comments": "workspace:*",
    "@cspell/parser-csharp-strings-comments": "workspace:*",
    "@cspell/parser-go-strings-comments": "workspace:*",
    "@cspell/parser-java-strings-comments": "workspace:*",
    "@cspell/parser-php-strings-comments": "workspace:*",
    "@cspell/parser-python-strings-comments": "workspace:*",
    "@cspell/parser-ruby-strings-comments": "workspace:*",
    "@cspell/parser-rust-strings-comments": "workspace:*",
    "@cspell/parser-typescript-strings-comments": "workspace:*"
  },
  "devDependencies": {
    "@cspell/cspell-types": "catalog:",
    "@internal/utils": "workspace:*"
  },
  "engines": {
    "cspell": ">=10.0.0",
    "node": ">=22.18.0"
  }
}
