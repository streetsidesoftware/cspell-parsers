{
  "name": "@cspell/parser-typescript",
  "version": "1.1.1",
  "description": "A TypeScript parser plugin for cspell.",
  "keywords": [
    "cspell",
    "parser",
    "plugin",
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/streetsidesoftware/cspell-parsers.git",
    "directory": "packages/parser-typescript"
  },
  "funding": "https://github.com/streetsidesoftware/cspell?sponsor=1",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0",
    "cspell": ">=10.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./parser": {
      "types": "./dist/parser.d.ts",
      "default": "./dist/parser.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./recommended": {
      "types": "./dist/recommended.d.ts",
      "default": "./dist/recommended.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "shx rm -rf dist coverage",
    "test": "pnpm run test:vitest && pnpm run test:cspell",
    "test:vitest": "vitest run",
    "test:cspell": "cspell . --no-progress",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cspell/parser-typescript-tree-sitter": "workspace:^"
  },
  "devDependencies": {
    "@cspell/cspell-types": "catalog:",
    "@internal/utils": "workspace:*"
  }
}
