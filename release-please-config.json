{
  "include-v-in-tag": false,
  "tag-separator": "@",
  "plugins": [
    {
      "type": "node-workspace",
      "always-link-local": true,
      "updatePeerDependencies": true
    }
  ],
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features",
      "hidden": false
    },
    {
      "type": "fix",
      "section": "Updates and Bug Fixes",
      "hidden": false
    },
    {
      "type": "perf",
      "section": "Performance Improvements",
      "hidden": false
    },
    {
      "type": "ci",
      "section": "Continuous Integration",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Miscellaneous",
      "hidden": true
    },
    {
      "type": "revert",
      "section": "Reverts",
      "hidden": false
    },
    {
      "type": "docs",
      "section": "Documentation",
      "hidden": true
    },
    {
      "type": "style",
      "section": "Styles",
      "hidden": true
    },
    {
      "type": "refactor",
      "section": "Code Refactoring",
      "hidden": false
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "build",
      "section": "Build System",
      "hidden": true
    }
  ],
  "packages": {
    ".": {
      "component": "cspell-parsers"
    },
    "packages/parser-example": {
      "component": "@cspell/parser-example"
    },
    "packages/parser-go-strings-comments": {
      "component": "@cspell/parser-go-strings-comments"
    },
    "packages/parser-javascript": {
      "component": "@cspell/parser-javascript"
    },
    "packages/parser-php-strings-comments": {
      "component": "@cspell/parser-php-strings-comments"
    },
    "packages/parser-strings-comments": {
      "component": "@cspell/parser-strings-comments"
    },
    "packages/parser-typescript": {
      "component": "@cspell/parser-typescript"
    },
    "packages/parser-typescript-strings-comments": {
      "component": "@cspell/parser-typescript-strings-comments"
    },
    "packages/parser-typescript-tree-sitter": {
      "component": "@cspell/parser-typescript-tree-sitter"
    },
    "packages/parser-typescript-tree-sitter-wasm": {
      "component": "@cspell/parser-typescript-tree-sitter-wasm"
    }
  }
}
