{
  "name": "cspell-parsers",
  "version": "1.1.5",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "fix:all": "pnpm exec fix-package-json && pnpm exec fix-release-please-config",
    "build:readme": "inject-markdown README.md \"packages/*/*.md\" && pnpm run lint",
    "clean": "pnpm -r run clean",
    "lint": "pnpm exec fix-package-json && pnpm exec fix-release-please-config && eslint . --fix && prettier --write .",
    "lint:eslint": "eslint . --fix",
    "lint:prettier": "prettier --write .",
    "lint-ci": "pnpm exec fix-package-json --dry-run && pnpm exec fix-release-please-config --dry-run && eslint . --max-warnings 0 && prettier --check .",
    "spell": "cspell --no-progress .",
    "test": "pnpm -r run test && pnpm run typecheck",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@cspell/cspell-json-reporter": "^10.3.3",
    "@eslint/js": "^10.0.1",
    "@internal/scripts": "workspace:*",
    "@lerna-lite/cli": "^5.6.1",
    "@lerna-lite/publish": "^5.6.1",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^24.13.4",
    "cspell": "catalog:",
    "eslint": "^10.10.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.12.0",
    "inject-markdown": "^5.0.3",
    "prettier": "^3.9.6",
    "shx": "^0.4.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
