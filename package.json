{
  "name": "cspell-parsers",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "clean": "pnpm -r run clean",
    "lint": "eslint . && prettier --write .",
    "lint-ci": "eslint . --max-warnings 0 && prettier --check .",
    "spell": "cspell --no-progress .",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^24.3.3",
    "cspell": "^10.3.1",
    "eslint": "^10.0.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "shx": "^0.4.0",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.43.0",
    "vitest": "catalog:"
  }
}
